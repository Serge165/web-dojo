{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Dojo",
  "version": "0.1.0",
  "identifier": "com.webdojo.app",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd frontend && REACT_APP_BACKEND_URL=http://127.0.0.1:8787 npm start",
    "beforeBuildCommand": "cd frontend && npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Web Dojo",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "externalBin": [
      "../backend/dist/webdojo-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "debian": {
        "depends": ["libwebkit2gtk-4.0-0", "libssl-dev", "libgtk-3-0"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}