{"nodes": [{"id": "docs_superpowers_specs_2026_08_18_codepen_editor_design", "label": "CodePen-Style Code Editor Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_custom_js_field", "label": "custom_js Page Field", "file_type": "concept", "rationale": "New page-level custom_js field mirroring how head_html is already modeled; editable as its own Monaco tab; injected as <script>${custom_js}</script> immediately before </body> in all four HTML-assembly functions, omitted entirely when empty.", "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_html_pane_sync", "label": "HTML Pane Live Two-Way Sync", "file_type": "concept", "rationale": "DOMParser-parsed top-level nodes are reconciled against the elements array by root id \u2014 a matching id updates that element in place, a missing/unrecognized id becomes a new element with a fresh uid(), and an existing element whose id no longer appears is removed; output order follows the parsed nodes' order.", "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_css_pane_sync", "label": "CSS Pane Live Two-Way Sync", "file_type": "concept", "rationale": "Regex-matches '.el-<id>{...}'/'.el-<id>__n{...}' rule blocks out of the pane text and writes matched declarations back onto the corresponding element's style attribute by occurrence index; an occurrence the pane didn't mention is left untouched rather than blanked.", "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_codeview_four_tab_redesign", "label": "CodeView Four-Tab CodePen Redesign", "file_type": "concept", "rationale": "Code mode redesigned from a read-only generated-output pane + editable head into four live-synced Monaco tabs (HTML, CSS, JS, Head) plus a debounced live preview iframe; HTML/CSS edits route through one shared debounced update function so a fast edit in one pane can't be clobbered by a stale reconciliation from the other.", "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "concept_custom_js_field", "target": "backend_server__project_to_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_custom_js_field", "target": "backend_server__build_project_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_custom_js_field", "target": "frontend_src_lib_exporthtml_buildstandalonehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_custom_js_field", "target": "frontend_src_lib_exporthtml_buildcleanexport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_html_pane_sync", "target": "frontend_src_lib_htmlpanesync_reconcileelementsfromhtml", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_css_pane_sync", "target": "frontend_src_lib_csspanesync_reconcileelementsfromcss", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_codeview_four_tab_redesign", "target": "frontend_src_components_builder_codeview_codeview", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-codepen-editor-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}