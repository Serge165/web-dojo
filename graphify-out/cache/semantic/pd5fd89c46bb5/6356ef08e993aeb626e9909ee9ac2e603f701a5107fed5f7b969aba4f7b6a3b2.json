{"nodes": [{"id": "docs_superpowers_specs_2026_08_17_audit_findings", "label": "Audit Findings \u2014 Backend + Frontend Review", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-17-audit-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_iframe_sandbox_fix", "label": "iframe Sandbox allow-same-origin Fix", "file_type": "rationale", "rationale": "All srcDoc iframes combined allow-scripts with allow-same-origin, giving injected preview content the app's real origin instead of an opaque one, letting any XSS injection reach back into the parent's DOM/localStorage. Fix drops allow-same-origin since none of the four iframes need same-origin access.", "source_file": "docs/superpowers/specs/2026-08-17-audit-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_setattr_replace_pattern_bug", "label": "setAttr/setInnerText String.replace Pattern Bug", "file_type": "rationale", "rationale": "setAttr/setInnerText pass user text as the replacement argument to String.prototype.replace(), where sequences like $&, $\\`, $', $1 are special replacement-pattern syntax, silently corrupting output. Fix: pass a replacer function instead of the raw string.", "source_file": "docs/superpowers/specs/2026-08-17-audit-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_src_components_builder_contextualeditors_setattr", "label": "setAttr()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-17-audit-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_src_pages_builder_builder", "label": "Builder page component", "file_type": "code", "source_file": "docs/superpowers/specs/2026-08-17-audit-findings.md", "source_location": null, "sour