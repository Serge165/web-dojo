{"nodes": [{"id": "docs_superpowers_plans_2026_08_17_audit_fix_round_2", "label": "Second Audit-Fix Round Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_jpy_zero_decimal_fix", "label": "JPY Zero-Decimal Currency Fix", "file_type": "rationale", "rationale": "Stripe amount builders unconditionally multiplied by 100 to get the smallest currency unit, but JPY is a zero-decimal currency and must be passed as-is \u2014 a JPY payment link for \u00a5500 actually charged \u00a550,000. Fixed via a ZERO_DECIMAL_CURRENCIES set consulted by a new _to_unit_amount helper shared by both Stripe amount builders.", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_publish_path_traversal_fix", "label": "Publish Filename Path Traversal Fix", "file_type": "rationale", "rationale": "html_filename/css_filename were free text used verbatim as the FTP/SFTP upload target with no rejection of '/', '\\\\', or a leading dot, allowing writes outside the configured remote_path. Fixed by rejecting any filename containing a path separator or starting with a dot, returning 400.", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_submission_body_size_cap", "label": "POST /api/submissions Body-Size Cap", "file_type": "rationale", "rationale": "/api/submissions is reachable by anonymous internet visitors by design with no Content-Length ceiling, allowing resource exhaustion via an arbitrarily large body fully buffered before validation. Fixed with a 1MB cap enforced by reading the request stream incrementally and aborting early, caching the body so downstream parsing can reuse it.", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server_list_submissions", "label": "list_submissions()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server_clear_submissions", "label": "clear_submissions()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server__to_unit_amount", "label": "_to_unit_amount()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server__extract_submission", "label": "_extract_submission()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server__cap_request_body", "label": "_cap_request_body()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_src_components_builder_submissionsmodal_submissionsmodal", "label": "SubmissionsModal component", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-audit-fix-round-2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_08_17_audit_fix_round_2", "target": "docs_sup