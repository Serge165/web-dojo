{"nodes": [{"id": "docs_superpowers_specs_2026_08_18_tauri_desktop_design", "label": "Tauri Desktop Packaging Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_tauri_desktop_packaging", "label": "Tauri Desktop Packaging", "file_type": "concept", "rationale": "Packages Web Dojo as a self-contained desktop app: a Tauri 2.x shell wrapping the existing React build, the existing FastAPI backend as a PyInstaller sidecar (no system Python required), and a new SQLite compatibility shim active only in the desktop build so the MongoDB web deployment is unchanged.", "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_sqlite_compat_shim", "label": "SQLite Motor-Compatibility Shim", "file_type": "concept", "rationale": "backend/sqlite_compat.py mimics the narrow subset of Motor's async API this codebase actually calls, storing one SQLite table per collection as id TEXT PRIMARY KEY, doc TEXT (a JSON blob) and filtering/sorting/limiting in Python rather than translating to SQL \u2014 deliberately simple since a single-user desktop app's dataset is tiny and the codebase never uses complex Mongo filters.", "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "concept_tauri_desktop_packaging", "target": "concept_sqlite_compat_shim", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_tauri_desktop_packaging", "target": "concept_pyinstaller_sidecar", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_sqlite_compat_shim", "target": "backend_sqlite_compat_sqliteclient", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_sqlite_compat_shim", "target": "backend_sqlite_compat_sqlitecollection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-18-tauri-desktop-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}