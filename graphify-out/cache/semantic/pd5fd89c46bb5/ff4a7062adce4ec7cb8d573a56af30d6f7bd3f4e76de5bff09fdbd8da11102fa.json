{"nodes": [{"id": "docs_superpowers_plans_2026_08_17_codebase_audit_fix", "label": "Codebase Audit & Fix Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_ssrf_import_url_fix", "label": "SSRF Fix in POST /api/import/url", "file_type": "rationale", "rationale": "Validate the resolved IP of the URL (and every redirect hop, revalidated manually rather than via httpx follow_redirects) against private/loopback/link-local/reserved ranges before fetching, since unrestricted server-side fetch could reach internal addresses like cloud metadata endpoints.", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_cors_misconfiguration_fix", "label": "CORS Wildcard-With-Credentials Fix", "file_type": "rationale", "rationale": "allow_origins='*' combined with allow_credentials=True is rejected by browsers anyway and the frontend never sends credentials, so allow_credentials is set False and the default origin allowlist narrowed to localhost-only, closing browser-based exfiltration of endpoints like the plaintext publish-preset secret.", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_stripe_hardcoded_key_fix", "label": "Remove Hardcoded Stripe Fallback Key", "file_type": "rationale", "rationale": "stripe.api_key = ... or 'sk_test_emergent' baked a hardcoded placeholder key into the binary and let commerce_config report inconsistent state; commerce endpoints now return 503 when STRIPE_SECRET_KEY is unset instead of silently using the fake key.", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_fernet_key_permissions_fix", "label": "Fernet Key File Permissions Fix", "file_type": "rationale", "rationale": "The auto-generated Fernet key file, which decrypts every saved publish-preset password, is written with the process's default umask (typically world/group-readable); os.chmod to 0600 immediately after write restricts it to owner read/write only.", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server_import_url", "label": "import_url() route", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server__resolve_is_public", "label": "_resolve_is_public()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server__validate_import_url", "label": "_validate_import_url()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_server__get_fernet", "label": "_get_fernet()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-17-codebase-audit-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_08_17_codebase_audit_fix", "target": "docs_superpowers_specs_2026_08_17_codebase_audit_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superp